<!-- Modal para mensajes moderno, responsivo y atractivo -->

<style>
    /* ── Page loader overlay ── */
    #av-loader {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        align-items: center;
        justify-content: center;
        background: rgba(10, 18, 40, .6);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
    }
    #av-loader.av-visible { display: flex; }

    #av-loader-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
        animation: av-card-in .22s ease;
    }
    @keyframes av-card-in {
        from { transform: scale(.82); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
    }

    /* SGA letras — degradado dorado a blanco */
    #av-loader-sga {
        font-size: 52px;
        font-weight: 900;
        letter-spacing: 8px;
        background: linear-gradient(135deg, #F59E0B, #ffffff, #D4AF37);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: none;
        line-height: 1;
        animation: av-sga-glow 2s ease-in-out infinite;
    }
    @keyframes av-sga-glow {
        0%, 100% { opacity: .82; }
        50%       { opacity: 1;   }
    }

    /* anillo giratorio alrededor de SGA */
    .av-ring-wrap {
        position: relative;
        width: 110px; height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .av-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 3px solid transparent;
        animation: av-spin 1.2s cubic-bezier(.55,.15,.45,.85) infinite;
    }
    /* Anillo exterior — dorado */
    .av-ring-outer {
        border-top-color: #F59E0B;
        border-right-color: rgba(245,158,11,.3);
        border-bottom-color: #D4AF37;
    }
    /* Anillo interior — verde */
    .av-ring-inner {
        inset: 12px;
        border: 2.5px solid transparent;
        border-top-color: #10B981;
        border-left-color: rgba(16,185,129,.3);
        animation-direction: reverse;
        animation-duration: .85s;
    }
    /* Halo — plateado pulsante */
    .av-ring-halo {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        border: 1.5px solid rgba(192,200,210,.35);
        box-shadow: 0 0 12px rgba(180,190,200,.15);
        animation: av-halo 1.8s ease-in-out infinite;
    }
    @keyframes av-halo {
        0%, 100% { transform: scale(1);    opacity: .6; }
        50%       { transform: scale(1.14); opacity: 0;  }
    }
    @keyframes av-spin { to { transform: rotate(360deg); } }

    /* texto "Cargando" — plateado/blanco */
    #av-loader-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin: 0;
        background: linear-gradient(90deg, #9CA3AF, #ffffff, #9CA3AF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        background-size: 200% auto;
        animation: av-shimmer 2.2s linear infinite;
    }
    @keyframes av-shimmer {
        from { background-position: 200% center; }
        to   { background-position: -200% center; }
    }
    #av-loader-label::after {
        content: '';
        -webkit-text-fill-color: #9CA3AF;
        animation: av-dots 1.4s steps(4, end) infinite;
    }
    @keyframes av-dots {
        0%  { content: '';    }
        25% { content: '.';  }
        50% { content: '..'; }
        75% { content: '...'; }
    }
</style>


<div id="av-loader" role="status" aria-label="Cargando página">
    <div id="av-loader-card">
        <div class="av-ring-wrap">
            <div class="av-ring-halo"></div>
            <div class="av-ring av-ring-outer"></div>
            <div class="av-ring av-ring-inner"></div>
            <span id="av-loader-sga">SGA</span>
        </div>
        <p id="av-loader-label">Cargando</p>
    </div>
</div>

<script src="/static/js/googletag.js?v=1.0.0"></script>
