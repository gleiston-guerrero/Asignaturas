    <script type="text/javascript">
        $(function () {
            $(document).ready(function () {
                $(".menu").click(function () {
                    $(".menuvertical").toggleClass("ampliarmenu");
                    $(".contenido").toggleClass("reducirmenu");
                });
            });
            var tamano = tamVentana()[0];
            if (tamano > 1000) {
                $(".menuvertical").addClass('ampliarmenu');
                $(".contenido").addClass('reducirmenu');
            }
            $(".action").click(function () {
                var href = $(this).attr('href');
                if (href && href !== '#') bloqueointerface();
                location.href = href;
            });
            $(".destino").click(function () {
                var href = $(this).attr('href');
                if (href && href !== '#') avShowLoader();
                location.href = href;
            });

            /* Interceptar cualquier enlace de navegación (no AJAX, no nueva pestaña) */
            $(document).on('click', 'a[href]', function (e) {
                var href = $(this).attr('href') || '';
                var target = $(this).attr('target') || '';
                if (
                    href.indexOf('javascript') === 0 ||
                    href === '#' ||
                    href === '' ||
                    target === '_blank' ||
                    $(this).hasClass('fancybox') ||
                    $(this).data('toggle') ||
                    $(this).hasClass('get_detail') ||
                    $(this).hasClass('get_file_viewer') ||
                    $(this).hasClass('btn-link')
                ) return;
                avShowLoader();
            });

        });

        function tamVentana() {
            var tam = [0, 0];
            if (typeof window.innerWidth != 'undefined') {
                tam = [window.innerWidth, window.innerHeight];
            } else if (typeof document.documentElement != 'undefined'
                && typeof document.documentElement.clientWidth !=
                'undefined' && document.documentElement.clientWidth != 0) {
                tam = [
                    document.documentElement.clientWidth,
                    document.documentElement.clientHeight
                ];
            } else {
                tam = [
                    document.getElementsByTagName('body')[0].clientWidth,
                    document.getElementsByTagName('body')[0].clientHeight
                ];
            }
            return tam;
        }
    </script>
    <style>
        /* ── Notificaciones flotantes — Aula Virtual ── */
        #av-notif-fab-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 6px;
            border-bottom: 1px solid rgba(224,231,239,.9);
            background: linear-gradient(135deg, rgba(24,102,154,.07), rgba(26,82,118,.04));
        }
        #av-notif-fab {
            position: relative;
            width: 42px; height: 42px; border-radius: 50%;
            border: 2px solid rgba(255,255,255,.18);
            cursor: pointer; outline: none;
            background: linear-gradient(135deg, #18669a 0%, #1a5276 100%);
            color: #fff; font-size: 17px;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 3px 12px rgba(24,102,154,.45), 0 1px 3px rgba(0,0,0,.1);
            transition: transform .22s cubic-bezier(.34,1.56,.64,1), box-shadow .22s;
            flex-shrink: 0;
        }
        #av-notif-fab:hover {
            transform: scale(1.13);
            box-shadow: 0 6px 20px rgba(24,102,154,.6), 0 2px 6px rgba(0,0,0,.12);
        }
        #av-notif-fab:active { transform: scale(.9); }
        #av-notif-fab .fa-bell {
            transform-origin: 50% 0%;
            animation: av-bell-ring 4s ease-in-out infinite;
        }
        @keyframes av-bell-ring {
            0%, 80%, 100% { transform: rotate(0deg); }
            83%  { transform: rotate(14deg); }
            86%  { transform: rotate(-11deg); }
            89%  { transform: rotate(9deg); }
            92%  { transform: rotate(-6deg); }
            95%  { transform: rotate(3deg); }
        }

        #av-notif-badge {
            position: absolute; top: -5px; right: -5px;
            background: #dc2626; color: #fff;
            font-size: 10px; font-weight: 800;
            min-width: 18px; height: 18px; border-radius: 9px; padding: 0 4px;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid #fff; pointer-events: none;
            animation: av-badge-pulse 2.5s ease-in-out infinite;
        }
        @keyframes av-badge-pulse {
            0%, 100% { transform: scale(1); }
            50%       { transform: scale(1.18); }
        }

        #av-notif-backdrop {
            display: none; position: fixed; inset: 0; z-index: 10002;
            background: rgba(15,23,42,.45);
            backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
        }
        #av-notif-backdrop.av-notif-open { display: block; }

        #av-notif-panel {
            position: fixed; top: 0; right: 0; bottom: 0;
            width: 360px; max-width: 100vw; z-index: 10003;
            background: #fff; display: flex; flex-direction: column;
            box-shadow: -4px 0 28px rgba(0,0,0,.15);
            transform: translateX(100%);
            transition: transform .28s cubic-bezier(.4,0,.2,1);
        }
        #av-notif-panel.av-notif-open { transform: translateX(0); }

        .av-np-head {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 18px; flex-shrink: 0;
            
            background: linear-gradient(135deg, #18669a 0%, #1a5276 100%);
        }
        .av-np-title {
            display: flex; align-items: center; gap: 10px;
            color: #fff; font-size: 15px; font-weight: 700;
        }
        .av-np-total {
            background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.35);
            color: #fff; font-size: 11px; font-weight: 800;
            padding: 2px 9px; border-radius: 10px;
        }
        .av-np-close {
            width: 32px; height: 32px; border-radius: 6px;
            border: 1px solid rgba(255,255,255,.3);
            background: rgba(255,255,255,.12);
            color: #fff; font-size: 14px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: background .15s; outline: none;
        }
        .av-np-close:hover { background: rgba(255,255,255,.28); }

        .av-np-body {
            flex: 1; overflow-y: auto; padding-bottom: 16px;
        }
        .av-np-body::-webkit-scrollbar { width: 4px; }
        .av-np-body::-webkit-scrollbar-track { background: #f1f5f9; }
        .av-np-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }

        .av-np-section-head {
            display: flex; align-items: center; gap: 8px;
            padding: 13px 18px 10px;
            position: sticky; top: 0;
            background: #f8fafc; border-bottom: 1px solid #e2e8f0;
            z-index: 1;
        }
        .av-np-section-label {
            font-size: 10.5px; font-weight: 800;
            text-transform: uppercase; letter-spacing: .5px;
            color: #64748b; flex: 1;
        }
        .av-np-section-label .fa { margin-right: 4px; }
        .av-np-section-count {
            font-size: 10px; font-weight: 800;
            background: #F59E0B; color: #fff;
            padding: 1px 8px; border-radius: 8px;
        }

        a.av-np-item {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 12px 18px; border-bottom: 1px solid #f1f5f9;
            text-decoration: none; color: inherit; transition: background .12s;
        }
        a.av-np-item:hover { background: #f8fafc; text-decoration: none; color: inherit; }
        a.av-np-item:last-child { border-bottom: none; }

        .av-np-item-icon {
            width: 36px; height: 36px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; flex-shrink: 0; margin-top: 1px;
        }
        .av-np-icon--act   { background: #fef3c7; color: #d97706; }
        .av-np-icon--notif { background: #dbeafe; color: #2563eb; }

        .av-np-item-body { flex: 1; min-width: 0; }
        .av-np-item-title {
            font-size: 12px; font-weight: 700; color: #1e293b;
            line-height: 1.35; margin-bottom: 4px;
        }
        .av-np-item-warn {
            font-size: 10.5px; color: #d97706; font-weight: 700;
            display: flex; align-items: center; gap: 4px; margin-bottom: 3px;
        }
        .av-np-item-meta {
            font-size: 10px; color: #64748b;
            display: flex; align-items: center; gap: 4px; flex-wrap: wrap;
        }
        .av-np-item-meta .fa { font-size: 9px; }
        .av-np-item-badge {
            display: inline-flex; align-items: center; gap: 4px;
            background: #fef9c3; color: #92400e;
            font-size: 10px; font-weight: 700;
            padding: 3px 8px; border-radius: 6px;
            flex-shrink: 0; align-self: center;
        }

        /* ── Panel estático — solo desktop ── */
        .av-notif-static {
            width: 270px;
            flex-shrink: 0;
            background: #fff;
            border-left: 1px solid #e2e8f0;
            height: auto;
            /* 60px = alto del navbar fijo (body tiene padding-top:60px);
               sin descontarlo el panel se pega detrás del navbar y su
               borde inferior queda fuera de la pantalla visible. */
            max-height: calc(86vh - 60px);
            overflow-y: auto;
            position: sticky;
            top: 60px;
        }
        .av-notif-static::-webkit-scrollbar { width: 4px; }
        .av-notif-static::-webkit-scrollbar-track { background: #f1f5f9; }
        .av-notif-static::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }
        .av-notif-static-head {
            display: flex; align-items: center; gap: 8px;
            padding: 13px 16px;
            background: linear-gradient(135deg, #18669a 0%, #1a5276 100%);
            position: sticky; top: 0; z-index: 1;
            color: #fff; font-size: 13px; font-weight: 700;
            opacity: 0.7;
        }
        .av-notif-static-head .fa { font-size: 14px; }

        @media (max-width: 1014px) and (min-width: 300px) {
            .av-notif-static { width: 100%; }
        }
        /* Panel estático visible en todos los tamaños, FAB y slide panel ocultos */
        #av-notif-fab-wrap { display: none !important; }
        #av-notif-panel   { display: none !important; }
        #av-notif-backdrop { display: none !important; }
        @media (max-width: 480px) {
            #av-notif-panel { width: 100%; }
        }
    </style>
    
    <script type="text/javascript" src='/static/js/select2.js?v=1.0.0' ></script>
    <link type='text/css' rel='stylesheet' href="/static/css/select2.css?v=1.0.0"/>
    <link href="/static/estilos/menus.css" rel="stylesheet" type="text/css" media="screen" />
    <link href="/static/sga/aulaVirtual/css/aulaVirtual.css" rel="stylesheet" type="text/css" media="screen" />
    <link href="/static/uteq/sga/aulaVirtual/css/bloqueo_x_calificacion.css" rel="stylesheet" type="text/css" media="screen">
    <script type="text/javascript" src="/static/uteq/sga/aulaVirtual/js/panel_aulavitual_docente.js"></script>
    <script type="text/javascript">

        $(function() {

            $(".cambiar_color").click(function () {
                var idm = $(this).attr('id');
                bloqueointerface();
                $.ajax({
                    type: "GET",
                    url: "/pro_planificacion",
                    data: {'action': 'cambiarcolor'}, success: function(data) {
                        $.unblockUI();
                        if (data.result === 'ok') {
                            $(".paletacolor").empty();
                            for (elemento in data.lista) {
                                $(".paletacolor").append('<div class="color">' +
                                    ' <a class="btn tu change_color" idm="'+idm+'" idc="'+data.lista[elemento][0]+'" style="background-color: '+data.lista[elemento][1]+';"></a>' +
                                    ' </div>')
                            }
                            controlador_color();
                            $('#itemspanel').modal({keyboard: false, backdrop: 'static', width: '265px'}).modal('show');
                        } else {
                            abrirnotificacionmodal(data.mensaje);
                        }
                    },
                    error: function() {
                        $.unblockUI();
                        abrirnotificacionmodal('Error de conexión.');
                    },
                    dataType: "json"
                });
            });
            controlador_color = function() {
                $(".change_color").click(function () {
                    var idc = $(this).attr('idc');
                    var idm = $(this).attr('idm');
                    if (idc == 0 || idm === '') {
                        abrirnotificacionmodal("Error al extraer los datos");
                        return false;
                    }
                    bloqueointerface();
                    $.ajax({
                        type: "POST",
                        url: "/pro_planificacion",
                        data: {'action': 'cambiarcolor', 'idm': idm, 'idc': idc}, success: function (data) {
                            $.unblockUI();
                            if (data.result === 'ok') {
                                $("#itemspanel").modal("hide");

                                $(".encabezado_" + idm).css({'background-color': data.codigocolor});
                            } else {
                                abrirnotificacionmodal(data.mensaje);
                            }
                        },
                        error: function () {
                            $.unblockUI();
                            abrirnotificacionmodal('Error de conexión.');
                        },
                        dataType: "json"
                    });
                });
            };
            $("#cerrarmodalcolor").click(function () {
                $("#itemspanel").modal("hide");
            });

            $(".actacontolfirma").click(function () {
                var id = $(this).attr('idm');
                $.ajax({
                    type: 'POST',
                    url: '/pro_planificacion',
                    data: {"action": "campomodeloevaluativo", "id": id},
                    success: function (data) {
                        $.unblockUI();
                        if (data.result==='ok'){
                            $(".ca-menu").empty();
                            for (elemento in data.lista) {
                                $(".ca-menu").append('<li><a class="class_campo" idd="' + data.lista[elemento][0] + '" idm="' + data.lista[elemento][3] + '">' +
                                    '<span class="ca-icon"><i class="fa fa-print"></i></span>' +
                                    '<div class="ca-content">' +
                                    '<h2 class="ca-main">' + data.lista[elemento][1] + '</h2>' +
                                    '<h2 class="ca-sub">'+ data.lista[elemento][2] + '</h3>' +
                                    '</div>' +
                                    '</a>' +
                                    '</li>');
                            }
                            controlador_opciones();
                            $(".actacontolfirmamodal").modal({width: 'auto'}).modal('show');
                        } else {
                            abrirnotificacionmodal(data.mensaje);
                        }
                    },
                    error: function() {
                        $.unblockUI();
                        abrirnotificacionmodal('Error de conexión.');
                    },
                    dataType: "json"
                });
            });
            controlador_opciones = function () {
                $(".class_campo").click(function () {
                    var idm = $(this).attr('idm');
                    var idd =  $(this).attr('idd');
                    openwindow('POST', '/pro_planificacion', {action: 'actacontrolfirma_pdf', idm: idm, idd:idd}, '_blank');
                    $(".actacontolfirmamodal").modal('hide');
                });
            };

            $(".cerraractacontrol").click(function () {
                $(".actacontolfirmamodal").modal('hide');
            });

            $(".avanceacademico").click(function () {
                var id = $(this).attr('idm');
                bloqueointerface();
                $.ajax({
                    type: 'POST',
                    url: '/pro_planificacion',
                    data: {"action": "seguimientosilabo", "id": id},
                    success: function (data) {
                        $.unblockUI();
                        if (data.result==='ok'){
                            $(".avanceacademicotitulo").html(data.titulo);
                            $(".avanceacademicocontenido").html(data.html);
                            $(".avanceacademicomodal").modal({width: '999px'}).modal('show');
                        } else {
                            abrirnotificacionmodal(data.mensaje);
                        }
                    },
                    error: function() {
                        $.unblockUI();
                        abrirnotificacionmodal('Error de conexión.');
                    },
                    dataType: "json"
                });
            });

            $(".avanceacademicocerrar").click(function () {
                $(".avanceacademicomodal").modal('hide');
            });
            $('[data-toggle="popover"]').popover();
            $(".informefinalactividad").click(function () {
                var id = $(this).attr('id');
                openwindow('POST', '/pro_planificacion', {action: 'informefinalactividad', id: id}, '_blank');
            });
            $(".reportematriculado").click(function () {
                $("#selecttipo").select2({minimumResultsForSearch: 4 });
                var id = $(this).attr('idm');
                $("#imprimir").attr('idm', id);
                $("#reportematriculados").modal({"backdrop":"static", "width": "450px"}).modal("show");
            });

            $("#imprimir").click(function () {
                var action = 'matriculados_excel';
                var idm = $(this).attr('idm');
                if ($(".selecttipo").val() === 1){
                    action = 'matriculados_pdf';
                }
                $("#reportematriculados").modal('hide');
                openwindow('POST', '/pro_planificacion', {action: action, id: idm, gmail: $("#checkgmail").is(':checked'), microsoft: $("#checkmicrosoft").is(':checked')}, '_blank');
            });
            $("#cerrar_matriculado").click(function () {
                $("#reportematriculados").modal('hide');
            });

            $(".descargarprogramaanalitico").click(function () {
                openwindow('POST', '/pro_planificacion', {action: 'programanaliticopdf', id: $(this).attr("id")}, '_blank');
            })
        });
    </script>


</head>

