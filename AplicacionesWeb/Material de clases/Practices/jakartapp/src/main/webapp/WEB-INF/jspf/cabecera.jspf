<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="es-EC">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TiendaUTEQ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/css/estilo.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-success">
  <div class="container">
    <a class="navbar-brand fw-bold" href="${ctx}/index.jsp">TiendaUTEQ</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <c:forEach var="p" items="${menu}">
          <c:set var="esJsp" value="${p.url=='index' or p.url=='mision' or p.url=='vision'}" />
          <li class="nav-item">
            <a class="nav-link" href="${ctx}/${p.url}${esJsp ? '.jsp' : ''}">${p.nombre}</a>
          </li>
        </c:forEach>
      </ul>
      <ul class="navbar-nav">
        <c:choose>
          <c:when test="${not empty usuario}">
            <li class="nav-item"><span class="nav-link text-white-50">${usuario.nombre}</span></li>
            <li class="nav-item"><a class="nav-link" href="${ctx}/logout">Salir</a></li>
          </c:when>
          <c:otherwise>
            <li class="nav-item"><a class="nav-link" href="${ctx}/login">Iniciar sesion</a></li>
          </c:otherwise>
        </c:choose>
      </ul>
    </div>
  </div>
</nav>
<main class="container my-4">
  <c:if test="${not empty sessionScope.flash}">
    <div class="alert alert-${sessionScope.flashTipo}">${sessionScope.flash}</div>
    <c:remove var="flash" scope="session" /><c:remove var="flashTipo" scope="session" />
  </c:if>
  <c:if test="${not empty sessionScope.flashAvisos}">
    <div class="alert alert-warning"><strong>Su pedido se actualizo:</strong>
      <ul class="mb-0"><c:forEach var="a" items="${sessionScope.flashAvisos}"><li>${a}</li></c:forEach></ul>
    </div>
    <c:remove var="flashAvisos" scope="session" />
  </c:if>
